# Single source of truth for pinned artifacts. Verified in Phase 0 (2026-10-08, WSL2 linux/amd64).
# Read by scripts/provision.sh and the Dockerfile.

LAYA_GO_MODULE=github.com/metalagman/laya-go
LAYA_GO_VERSION=v0.2.6

# ONNX Runtime 1.29.0 (CPU, linux-x64)
ORT_VERSION=1.29.0
ORT_URL=https://github.com/microsoft/onnxruntime/releases/download/v1.29.0/onnxruntime-linux-x64-1.29.0.tgz
ORT_ARCHIVE_SHA256=c3fddc4f139a045b0c4902c57410f0694f1c2fdf9b6939fbe38b1aeae7cd14ba
ORT_LIB_PATH=onnxruntime-linux-x64-1.29.0/lib/libonnxruntime.so.1.29.0
ORT_LIB_SHA256=5715f06d8992ca8eeeddcce43df3a7d38f97d537052126f558e912cb312460ca

# daulet/tokenizers static library (libtokenizers.a, linked at build time via CGO_LDFLAGS)
TOKENIZERS_VERSION=v1.27.0
TOKENIZERS_URL=https://github.com/daulet/tokenizers/releases/download/v1.27.0/libtokenizers.linux-amd64.tar.gz
TOKENIZERS_ARCHIVE_SHA256=72556cdca798dd4ea7cdaba308e5f0d68a8cb93b67c96edf485b7a0edd7b07f4
TOKENIZERS_LIB_PATH=libtokenizers.a
TOKENIZERS_LIB_SHA256=e6862b31745bb7d07980fcee70e49cd3b4318097609180f5d2d3fb394f305d50

# Official checkpoint (file table and SHA-256 per file live in laya-go's
# tools/export/profiles/laya-multilingual-v1.json)
CHECKPOINT_REPO=convaiinnovations/laya-multilingual
CHECKPOINT_REVISION=052592a15d198d9ad47da779604259b10b47b7aa

# Reference SDK used by the exporter for preprocessing parity
SDK_REPO=NandhaKishorM/laya
SDK_REVISION=573e5b62696ba441230cd6be71d593331b5d23af
SDK_ARCHIVE_SHA256=03931635a92b7609c6c253ac1d4d618ebe4fc54956744db01c027b504fd9c426

# Export determinism input (laya-go docs/official-export-v1.md)
SOURCE_DATE_EPOCH=1790035200

# Resulting bundle identity (sha256 of manifest.json) produced in Phase 0
EXPECTED_BUNDLE_ID=sha256:ca06dcb1166aad3287d32ed5423d4551d36af246acc0e0421780c141b9377f23
