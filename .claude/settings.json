{
  "permissions": {
    "allow": [
      "Bash(rtk grep *)",
      "Skill(update-config)",
      "Skill(update-config:*)",
      "Bash(docker exec *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "/home/fsvxavier/.local/bin/graphify hook-guard search"
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "/home/fsvxavier/.local/bin/graphify hook-guard read"
          }
        ]
      }
    ]
  },
  "disableAllHooks": true,
  "enabledPlugins": {
    "repomix-explorer@repomix": true,
    "repomix-mcp@repomix": true,
    "repomix-commands@repomix": true,
    "ponytail@ponytail": true,
    "ruflo-arena@ruflo": true,
    "ruflo-metaharness@ruflo": true,
    "ruflo-sparc@ruflo": true,
    "ruflo-ruvector@ruflo": true,
    "ruflo-observability@ruflo": true,
    "ruflo-neural-trader@ruflo": true,
    "ruflo-migrations@ruflo": true,
    "ruflo-market-data@ruflo": true,
    "ruflo-knowledge-graph@ruflo": true,
    "ruflo-iot-cognitum@ruflo": true,
    "ruflo-graph-intelligence@ruflo": true,
    "ruflo-federation@ruflo": true,
    "ruflo-ddd@ruflo": true,
    "ruflo-cost-tracker@ruflo": true,
    "ruflo-adr@ruflo": true,
    "ruflo-goals@ruflo": true,
    "ruflo-plugin-creator@ruflo": true,
    "ruflo-rvf@ruflo": true,
    "ruflo-ruvllm@ruflo": true,
    "ruflo-daa@ruflo": true,
    "ruflo-workflows@ruflo": true,
    "ruflo-agent@ruflo": true,
    "ruflo-jujutsu@ruflo": true,
    "ruflo-browser@ruflo": true,
    "ruflo-aidefence@ruflo": true,
    "ruflo-agentdb@ruflo": true,
    "ruflo-intelligence@ruflo": true,
    "ruflo-autopilot@ruflo": true,
    "ruflo-docs@ruflo": true,
    "ruflo-testgen@ruflo": true,
    "ruflo-rag-memory@ruflo": true,
    "ruflo-security-audit@ruflo": true,
    "ruflo-loop-workers@ruflo": true,
    "ruflo-swarm@ruflo": true,
    "ruflo-core@ruflo": true,
    "claude-mem@thedotmack": true,
    "caveman@caveman": true
  },
  "autoMemoryEnabled": true,
  "env": {
    "ANTHROPIC_SUBAGENT_MODEL": "claude-4-5-haiku",
    "CLAUDE_CODE_SUBAGENT_MODEL": "haiku"
  }
}
